# Routing provider configuration (US-005). Copy this file to `.env`, pick
# one provider, and set its API key. Both variables are required — the app
# fails clearly at startup if either is missing or the provider name is
# unknown. See README.md for how to obtain a key for each provider.
#
# This key ships in the client bundle and is therefore public. Restrict it
# to your deployed domain and keep it on a capped free tier before any
# public deploy (docs/ARCHITECTURE.md).

# One of: openrouteservice, mapbox
VITE_ROUTING_PROVIDER=openrouteservice
VITE_ROUTING_API_KEY=
